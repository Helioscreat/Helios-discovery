{
  "_comment": "Infrastructure de production, région UE. Lancement : une instance Scaleway fr-par avec SQLite sur volume et sauvegardes quotidiennes (docs/deploiement-serveur.md). PostgreSQL managé avant tout second serveur.",
  "provider": "scaleway",
  "resources": [
    {
      "kind": "instance",
      "name": "helios-api",
      "region": "fr-par",
      "image": "ghcr.io/helioscreat/helios-discovery-server:latest",
      "env": [
        "ALLOWED_ORIGINS",
        "MODERATORS",
        "ADMIN_KEYS",
        "CONTACT_EMAIL",
        "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
        "APPLE_ISSUER_ID",
        "APPLE_KEY_ID",
        "APPLE_PRIVATE_KEY_FILE"
      ]
    },
    {
      "kind": "blockVolume",
      "name": "helios-data",
      "region": "fr-par",
      "sizeGb": 10,
      "encryptionAtRest": true,
      "mount": "/srv/helios",
      "backupRetentionDays": 30
    },
    {
      "kind": "objectStorage",
      "name": "helios-backups",
      "region": "fr-par",
      "lifecycleDays": 30,
      "optional": true
    },
    {
      "kind": "database",
      "engine": "postgresql-16",
      "region": "fr-par",
      "encryptionAtRest": true,
      "backupRetentionDays": 30,
      "when": "avant un second serveur"
    }
  ]
}
