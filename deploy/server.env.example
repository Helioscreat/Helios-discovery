# Copier en /opt/helios/server.env, chmod 600. Jamais dans le dépôt.
API_DOMAIN=api.exemple.fr
# Applications natives (Capacitor) : Android https://localhost, iOS capacitor://localhost
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
CONTACT_EMAIL=fleurant.m@icloud.com
# Clés individuelles, séparées par des virgules (générer avec : openssl rand -hex 32)
MODERATORS=
ADMIN_KEYS=
# Google Play : contenu du fichier JSON du compte de service, sur une seule ligne
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE=com.helioscreat.heliosdiscovery
# App Store : clé d'achats intégrés (contenu du .p8, retours à la ligne remplacés par \n) ou chemin du fichier
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_FILE=/data/secrets/AuthKey.p8
APPLE_BUNDLE_ID=com.helioscreat.heliosdiscovery
